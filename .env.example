# PostgreSQL (ตรงกับ docker-compose.yml)
DATABASE_URL="postgresql://dorm:dorm@localhost:5432/dorm?schema=public"

# ใช้เซ็น session cookie — สุ่มใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# บัญชีเริ่มต้นที่ seed สร้างให้
SEED_OWNER_EMAIL="admin@gmail.com"
SEED_OWNER_PASSWORD="pass123"
SEED_TECH_PHONE="1234567890"
SEED_TECH_PASSWORD="pass123"

# เข้ารหัสเลขบัตรประชาชน (AES-256-GCM) — hex 64 ตัว สุ่มด้วยคำสั่งเดียวกับ AUTH_SECRET
# ห้ามเปลี่ยนหลังมีข้อมูลแล้ว ไม่งั้นถอดรหัสข้อมูลเดิมไม่ได้
ENCRYPTION_KEY=""

# ป้องกัน /api/cron/billing — ตัวเรียกต้องส่ง header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
