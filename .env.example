# ฐานข้อมูล — เลือกอย่างใดอย่างหนึ่ง
#
# ก) Supabase / Postgres บนคลาวด์ (ต่อผ่าน connection pooler)
#    เอาจาก Dashboard → Connect → ORMs → Prisma
# DATABASE_URL="postgresql://postgres.<ref>:<รหัส>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<รหัส>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#    region ที่เลือกต้องตรงกับ regions ใน vercel.json ด้วย
#
# ข) Postgres ในเครื่อง (ตรงกับ docker-compose.yml) — ไม่ต้องใส่ DIRECT_URL
DATABASE_URL="postgresql://dorm:dorm@localhost:5432/dorm?schema=public"

# ใช้เซ็น session cookie — สุ่มใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# บัญชีเริ่มต้นที่ seed สร้างให้
SEED_OWNER_EMAIL="admin@gmail.com"
SEED_OWNER_PASSWORD="pass123"
SEED_TECH_PHONE="1234567890"
SEED_TECH_PASSWORD="pass123"

# เข้ารหัสเลขบัตรประชาชน (AES-256-GCM) — hex 64 ตัว สุ่มด้วยคำสั่งเดียวกับ AUTH_SECRET
# ห้ามเปลี่ยนหลังมีข้อมูลแล้ว ไม่งั้นถอดรหัสข้อมูลเดิมไม่ได้
ENCRYPTION_KEY=""

# ป้องกัน /api/cron/billing — ตัวเรียกต้องส่ง header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# เข้าสู่ระบบด้วย LINE (LIFF) ฝั่งผู้เช่า — เว้นว่างไว้ได้ ระบบจะซ่อนปุ่ม LINE ให้เอง
# เอาจาก LINE Developers Console → ช่อง LINE Login
#   NEXT_PUBLIC_LIFF_ID   = แท็บ LIFF → LIFF ID (เช่น 1234567890-AbCdEfGh) · ค่านี้ไม่ใช่ความลับ
#   LINE_LOGIN_CHANNEL_ID = แท็บ Basic settings → Channel ID (ใช้ฝั่งเซิร์ฟเวอร์ตรวจ ID token)
# Endpoint URL ของ LIFF ต้องชี้มาที่  https://<โดเมนของคุณ>/t/line  และเปิด scope: openid, profile
NEXT_PUBLIC_LIFF_ID=""
LINE_LOGIN_CHANNEL_ID=""
